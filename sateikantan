}

/* ========= Summary Editor (editable daily logs) ========= */
function SummaryEditor(){
  const [date, setDate] = React.useState(new Date().toISOString().slice(0,10));
  const [rows, setRows] = React.useState([]);
  const [indexMap, setIndexMap] = React.useState([]);
  React.useEffect(()=>{
    const all = loadLogs();
    const list = []; const idxs = [];
    all.forEach((l,idx)=>{
      const day = (l.date||'').slice(0,10);
      if(day===date){
        list.push({
          time: (l.time||'').slice(11,19) || '',
          contractNo: l.contractNo||'',
          saleTotal: Number(l.saleTotal||0),
          payoutTotal: Number(l.payoutTotal||0),
          profitTotal: Number(l.profitTotal||0),
          leadShort: l.leadShort||'',
          age: l.age||'',
          gender: l.gender||'',
          staff: l.staff||'',
          lines: Number(l.lines||0),
          _delete:false,
        });
        idxs.push(idx);
      }
    });
    setRows(list); setIndexMap(idxs);
  },[date]);
  const setField = (i,k,v)=> setRows(prev=> prev.map((r,idx)=> idx===i? {...r,[k]: v}: r));
  const addRow = ()=> setRows(prev=> [...prev, { time:'12:00:00', contractNo:'', saleTotal:0, payoutTotal:0, profitTotal:0, leadShort:'', age:'', gender:'', staff:'', lines:0, _new:true, _delete:false }]);
  const toggleDel = (i)=> setRows(prev=> prev.map((r,idx)=> idx===i? {...r, _delete:!r._delete}: r));
  const save = ()=>{
    const all = loadLogs();
    // delete targets
    const delSet = new Set();
    rows.forEach((r,i)=>{ const idx=indexMap[i]; if(r._delete && idx!=null) delSet.add(idx); });
    let newAll = all.filter((_,idx)=> !delSet.has(idx));
    // update
    rows.forEach((r,i)=>{
      const idx = indexMap[i];
      if(idx!=null && !r._delete){
        const profit = Number(r.saleTotal||0) - Number(r.payoutTotal||0);
        const base = newAll[idx] || {};
        newAll[idx] = { ...base,
          saleTotal: Number(r.saleTotal||0),
          payoutTotal: Number(r.payoutTotal||0),
          profitTotal: profit,
          leadShort: r.leadShort||'', age: r.age||'', gender: r.gender||'', staff: r.staff||'',
          lines: Number(r.lines||0),
          contractNo: r.contractNo || base.contractNo || '',
          time: base.time || base.date || (date+'T'+(r.time||'12:00:00')), date: base.date || (date+'T'+(r.time||'12:00:00'))
        };
      }
    });
    // add new rows
    rows.forEach((r)=>{
      if(r._new && !r._delete){
        const profit = Number(r.saleTotal||0) - Number(r.payoutTotal||0);
        const dt = date + 'T' + (r.time||'12:00:00');
        newAll.push({ date: dt, time: dt, contractNo: r.contractNo||'', saleTotal: Number(r.saleTotal||0), payoutTotal: Number(r.payoutTotal||0), profitTotal: profit, lines: Number(r.lines||0), leadShort: r.leadShort||'', age: r.age||'', gender: r.gender||'', staff: r.staff||'', items: [], payment:'', customerName:'' });
      }
    });
    saveLogs(newAll);
    showToast('日次集計を保存しました');
  };
  return (
    <section style={{border:'1px solid #eee', borderRadius:10, padding:12, display:'grid', gap:8}}>
      <div style={{fontWeight:700, color:BRAND_RED}}>日次集計（編集）</div>
      <div style={{display:'flex', gap:8, alignItems:'center'}}>
        <span style={{fontSize:12,color:'#555'}}>日付</span>
        <input type="date" value={date} onChange={e=>setDate(e.target.value)} style={{padding:8}} />
        <button onClick={addRow} style={{marginLeft:8, padding:'6px 10px', border:'1px solid #111', background:'#fff', borderRadius:6}}>行を追加</button>
        <button onClick={save} style={{background:BRAND_RED, color:'#fff', padding:'6px 10px', border:'none', borderRadius:6}}>保存</button>
