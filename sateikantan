                      <div style={{fontSize:12,color:'#666'}}>自動計算: ¥{autoPayout(r).toLocaleString()}</div>
                      <button onClick={()=>upd(i, null, { ...r, payoutMode:'auto' })} style={{padding:'4px 8px'}}>自動に戻す</button>
