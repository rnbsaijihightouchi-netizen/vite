/** ========= Helpers ========= **/
const loadJSON = (k, def) => { try { const s = localStorage.getItem(k); return s ? { ...def, ...(JSON.parse(s)||{}) } : { ...def }; } catch { return { ...def }; } };
const saveJSON  = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v||{})); } catch {} };
const loadArray = (k) => { try { const a = JSON.parse(localStorage.getItem(k)||"[]"); return Array.isArray(a) ? a : []; } catch { return []; } };
const saveArray = (k, a) => { try { localStorage.setItem(k, JSON.stringify(a||[])); } catch {} };
// Debounced localStorage writer (batches within 150ms)
let __saveQueue = {};
let __saveTimer = null;
function saveLater(k, v, isArray=false, delay=150){
  try{
    __saveQueue[k] = JSON.stringify(isArray ? (v||[]) : (v||{}));
    if(__saveTimer) clearTimeout(__saveTimer);
    __saveTimer = setTimeout(()=>{
      Object.keys(__saveQueue).forEach(key=>{ try{ localStorage.setItem(key, __saveQueue[key]); } catch {} });
      __saveQueue = {};
      __saveTimer = null;
    }, delay);
  }catch{}
}

