                <td style={{border:'1px solid #ddd', padding:6}}>{renderItemCell(r,i)}</td>
                <td style={{border:'1px solid #ddd', padding:6, textAlign:'right'}}>
                  <input type="number" value={r.qty||0} onChange={e=>upd(i,'qty', Number(e.target.value))} style={{padding:6, width:90, textAlign:'right'}} />
