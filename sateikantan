  const rIdType = useRef(); const rIdNum = useRef(); const rExpiry = useRef();
  const OCCUPATIONS = ["会社員","公務員","自営業","パート・アルバイト","学生","主婦(主夫)","無職","退職","その他"];
  const AGE_OPTIONS = Array.from({length:83}, (_,i)=> String(i+18)); // 18〜100
  const [occSel, setOccSel] = useState(OCCUPATIONS.includes(init.occupation||"") ? init.occupation : (init.occupation ? "その他" : ""));
  const [zipMsg, setZipMsg] = useState("");
  const calcAge = (iso) => { if (!iso) return ""; const d = new Date(iso); if (isNaN(d)) return ""; const t = new Date(); let a = t.getFullYear() - d.getFullYear(); const m = t.getMonth() - d.getMonth(); if (m < 0 || (m === 0 && t.getDate() < d.getDate())) a--; return String(Math.max(0, a)); };
  const onBirthChange = (e) => {
    const v = e.target.value || '';
    if (rAge.current) {
      const a = calcAge(v);
      if (a) rAge.current.value = a;
    }
  };
  const sanitizeZip = (s) => (s||'').replace(/[^0-9]/g,'');
  const searchZip = async () => {
    const raw = rZip.current?.value || '';
    const zip = sanitizeZip(raw);
    if (zip.length !== 7) { setZipMsg('7桁の郵便番号を入力'); return; }
    try {
      setZipMsg('検索中...');
      const res = await fetch('https://zipcloud.ibsnet.co.jp/api/search?zipcode=' + zip);
      const data = await res.json();
      if (data && data.results && data.results[0]) {
        const r = data.results[0];
        const addr = (r.address1||'') + (r.address2||'') + (r.address3||'');
        if (rAddr.current) rAddr.current.value = addr;
        setZipMsg('住所を反映しました');
      } else {
        setZipMsg('見つかりませんでした');
      }
    } catch(e) { setZipMsg('検索エラー'); }
