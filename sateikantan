      name: rName.current?.value || "",
      phone: rPhone.current?.value || "",
      postalCode: rZip.current?.value || "",
      address: rAddr.current?.value || "",
      
      birthDate: bd,
      age: ageVal,
      gender: rGender.current?.value || "",
