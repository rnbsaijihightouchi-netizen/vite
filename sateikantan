function openDailySummaryTab(){
  const logs = loadLogs();
  const d = new Date();
  const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), da = String(d.getDate()).padStart(2,'0');
  const dayKey = `${y}-${m}-${da}`;
  const todays = logs.filter(l => (l.date||'').startsWith(dayKey));
  let sumSale=0, sumPay=0, sumProfit=0, sumLines=0;
  const rowsHtml = todays.map(l => {
    sumSale += l.saleTotal||0; sumPay += l.payoutTotal||0; sumProfit += l.profitTotal||0; sumLines += l.lines||0;
    const when = (l.time||'').slice(11,19);
    const lead=(l.leadShort||''); const age=(l.age||''); const gender=(l.gender||''); const staff=(l.staff||'');
    return `<tr><td>${when}</td><td>${l.contractNo||''}</td><td style="text-align:right">¥${(l.saleTotal||0).toLocaleString()}</td><td style="text-align:right">¥${(l.payoutTotal||0).toLocaleString()}</td><td style="text-align:right">¥${(l.profitTotal||0).toLocaleString()}</td><td>${lead}</td><td>${age}</td><td>${gender}</td><td>${staff}</td><td style="text-align:right">${l.lines||0}</td></tr>`;
  }).join('');
  const header = ['時刻','契約番号','上代合計','下代合計','粗利合計','流入','年齢','性別','担当者','明細数'];
  const esc = (s) => { const t = String(s==null ? '' : s); const needs = t.includes('"') || t.includes(',') || t.includes('\n'); const t2 = t.replace(/\"/g,'""'); return needs ? '"'+t2+'"' : t2; };
  const rowsCsv = (todays||[]).map(l => [ (l.time||'').slice(11,19), l.contractNo||'', l.saleTotal||0, l.payoutTotal||0, l.profitTotal||0, l.leadShort||'', l.age||'', l.gender||'', l.staff||'', l.lines||0 ]);
  const csv = [header.map(esc).join(',')].concat(rowsCsv.map(r => r.map(esc).join(','))).join('\r\n');
  const csvHref = 'data:text/csv;charset=utf-8,%EF%BB%BF' + encodeURIComponent(csv);
  const html = '<!doctype html><html><head><meta charset="utf-8"><title>日次集計 ' + dayKey + '</title>' +
  '<style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,"Hiragino Kaku Gothic ProN",Meiryo,sans-serif;margin:0;padding:16px;color:#111}' +
  'h2{margin:0 0 8px;color:' + BRAND_RED + '}' +
  'table{border-collapse:collapse;width:100%;margin-top:10px} th,td{border:1px solid #ddd;padding:6px;font-size:13px} th{background:#f9fafb;text-align:left}' +
  '.tot{margin-top:10px;text-align:right} .btns{display:flex;gap:8px;margin-top:12px} @media print{.btns{display:none}}' +
  '</style></head><body>' +
  '<h2>日次集計 ' + dayKey + '</h2>' +
  '<table><thead><tr><th>時刻</th><th>契約番号</th><th style="text-align:right">上代合計</th><th style="text-align:right">下代合計</th><th style="text-align:right">粗利合計</th><th>流入</th><th>年齢</th><th>性別</th><th>担当者</th><th style="text-align:right">明細数</th></tr></thead><tbody>' + (rowsHtml||'') + '</tbody></table>' +
  '<div class="tot">上代合計 ¥' + sumSale.toLocaleString() + ' ／ 下代合計 ¥' + sumPay.toLocaleString() + ' ／ 粗利合計 ¥' + sumProfit.toLocaleString() + ' ／ 明細合計 ' + sumLines + '</div>' +
  '<div class="btns">' +
    '<button onclick="window.print()" style="padding:8px 12px;border:1px solid ' + BRAND_RED + ';background:#fff;color:' + BRAND_RED + ';border-radius:8px;cursor:pointer">印刷（PDF保存）</button>' +
    '<a href="' + csvHref + '" download="daily_' + dayKey + '.csv" style="padding:9px 12px;border:1px solid #111;background:#fff;color:#111;border-radius:8px;text-decoration:none;display:inline-block">CSVダウンロード</a>' +
  '</div>' +
  '</body></html>';
  const w = window.open('', '_blank'); if(!w){ showToast('ポップアップを許可してください','warn'); return; }
  w.document.write(html);
  w.document.close();
}

