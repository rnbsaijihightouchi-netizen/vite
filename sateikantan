                </td>
                <td style={{border:'1px solid #ddd', padding:6, textAlign:'right', color: profit(r)<0?'#E60012':'#111'}}>¥{profit(r).toLocaleString()}</td>
                <td style={{border:'1px solid #ddd', padding:6}}>
                  <div style={{display:'grid', gap:6}}>
