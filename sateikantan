const saveSettings = (obj) => { try { localStorage.setItem(LS.settings, JSON.stringify(obj||{})); } catch {} };
const pruneLogs = (keepDays=60) => { const logs = loadLogs(); const cutoff = Date.now() - (Number(keepDays)||60)*24*60*60*1000; const pruned = logs.filter(l=>{ const t = Date.parse(l.date||l.time||''); return isFinite(t) ? t >= cutoff : true; }); saveLogs(pruned); };

/** ========= Toast (Feedback) ========= **/
function showToast(msg, type='info'){ try{ window.dispatchEvent(new CustomEvent('SHOW_TOAST', { detail:{ msg, type } })); }catch{} }
function ToastHost(){
  const [toasts, setToasts] = React.useState([]);
  React.useEffect(()=>{
    const h = (e)=>{ const d=e.detail||{}; const id=Date.now()+Math.random(); setToasts(t=>[...t,{id, msg:String(d.msg||''), type:d.type||'info'}]); setTimeout(()=> setToasts(t=> t.filter(x=> x.id!==id)), 2600); };
    window.addEventListener('SHOW_TOAST', h);
    return ()=> window.removeEventListener('SHOW_TOAST', h);
  },[]);
  const bg = (t)=> t.type==='error' ? '#ef4444' : (t.type==='warn' ? '#f59e0b' : '#111');
  return (<div style={{position:'fixed', right:12, top:12, display:'grid', gap:8, zIndex:99999}}>
    {toasts.map(t=> <div key={t.id} style={{background:bg(t), color:'#fff', padding:'10px 12px', borderRadius:8, boxShadow:'0 4px 16px rgba(0,0,0,.18)'}}>{t.msg}</div>)}
  </div>);
}
