/** ========= Items Editor (統合査定テーブル) ========= **/
function ItemsEditor(){
  const [items, setItems] = useState(()=> loadArray(LS.items));
  useEffect(()=>{ const h = ()=> setItems([]); window.addEventListener('CLEAR_ITEMS', h); return ()=> window.removeEventListener('CLEAR_ITEMS', h); },[]);
  useEffect(()=>{ saveLater(LS.items, items, true, 150); }, [items]);
  // 外部からの復元に対応（スナップショット→RELOAD_ITEMS）
  useEffect(()=>{ const h=()=> setItems(loadArray(LS.items)); window.addEventListener('RELOAD_ITEMS', h); return ()=> window.removeEventListener('RELOAD_ITEMS', h); },[]);

  const prices = loadJSON(LS.prices, DEFAULT_PRICES);
  const brands = (()=>{ const b = loadArray(LS.brands); return (Array.isArray(b) && b.length) ? b : DEFAULT_BRANDS; })();
  const categoryMaster = (()=>{ const a = loadArray(LS.categories); return (Array.isArray(a)&&a.length)? a : DEFAULT_CATEGORIES; })();
  const itemMaster = (()=>{ try{ const j = JSON.parse(localStorage.getItem(LS.itemsMaster)||"null"); return (j && typeof j==='object') ? j : DEFAULT_ITEM_MASTER; }catch{ return DEFAULT_ITEM_MASTER; } })();

  const metalKeyFromLabel = (label)=>{ const m = METAL_ITEMS.find(x=>x.label===label); return m? m.k : label; };

  const addRow = () => setItems(prev=>[
    ...prev,
    {selected:true, category:'貴金属', item:'K18', detail:'', qty:1, unit:(prices['K18']||0), rate:10, priceKey:'K18', sync:true, payoutMode:'auto', payoutManual:0}
  ]);
  const delRow = (i) => setItems(prev=> prev.filter((_,idx)=> idx!==i));
  const upd = (i, k, v) => setItems(prev => prev.map((r, idx) => { if (idx !== i) return r; if (k == null) { return { ...r, ...(v||{}) }; } return { ...r, [k]: v }; }));

  const applyFromPrice = (i, priceKey) => { setItems(prev=> prev.map((r,idx)=>{ if(idx!==i) return r; const unit = Number(prices[priceKey]||0); return { ...r, unit, priceKey, sync:true }; })); };

  const sale   = (r) => Number(r.unit||0) * Number(r.qty||0);
  const autoPayout = (r) => floor100(sale(r) * Number(r.rate||0) / 10);
  const payout = (r) => (r.payoutMode==='manual' ? floor100(Number(r.payoutManual||0)) : autoPayout(r));
  const profit = (r) => sale(r) - payout(r);

  // 買いこぼしへ送る
  const toMissed = (r) => {
    const now = new Date();
    const offer = (r.payoutMode==='manual' ? floor100(Number(r.payoutManual||0)) : autoPayout(r));
    appendMissed({
      date: now.toISOString(),
      category: r.category||'',
      name: r.name || [r.item, r.detail].filter(Boolean).join(' '),
      qty: Number(r.qty||0),
      offer: offer,
      unit: Number(r.unit||0),
      rate: Number(r.rate||0),
      reason: '',
      memo: '',
      next: '',
      staff: (loadJSON(LS.staff, {name:''}).name||'')
    });
  };

  // 一括：相場から再適用（同期ONの貴金属行のみ）
  const reapplyAll = async () => {
    const targetIdxs = items.map((r,i)=> (r.category==='貴金属' && r.sync && r.priceKey) ? i : -1).filter(i=> i>=0);
    if(!targetIdxs.length){ showToast('対象行がありません','warn'); return; }
    showToast('相場を適用中…');
    const chunk = 50;
    let updated = [...items];
    for(let i=0; i<targetIdxs.length; i+=chunk){
      for(let j=i; j<Math.min(i+chunk, targetIdxs.length); j++){
        const idx = targetIdxs[j];
        const r = updated[idx];
        const unit = Number(prices[r.priceKey]||0);
        updated[idx] = { ...r, unit };
      }
      setItems(updated);
      await new Promise(res=> setTimeout(res, 0));
    }
    showToast('相場を再適用しました');
  };

  const memoTotals = React.useMemo(()=>{
    const sel = items.filter(r=>r.selected);
    const totalSale   = sel.reduce((s,r)=> s + sale(r), 0);
    const totalPayout = sel.reduce((s,r)=> s + payout(r), 0);
    const totalProfit = totalSale - totalPayout;
    const totalTax    = Math.floor(totalPayout * 0.10);
    const totalInc    = totalPayout + totalTax;
    const totalQtySel = sel.reduce((s,r)=> s + Number(r.qty||0), 0);
    return { totalSale, totalPayout, totalProfit, totalTax, totalInc, totalQtySel };
  }, [items]);
  const { totalSale, totalPayout, totalProfit, totalTax, totalInc, totalQtySel } = memoTotals;

  // keyboard events for quick actions in this table
  useEffect(()=>{
    const onAdd = ()=> addRow();
    const onReapply = ()=> reapplyAll();
    window.addEventListener('ADD_ITEM_ROW', onAdd);
    window.addEventListener('REAPPLY_PRICES', onReapply);
    return ()=> {
      window.removeEventListener('ADD_ITEM_ROW', onAdd);
      window.removeEventListener('REAPPLY_PRICES', onReapply);
    };
  }, [addRow, reapplyAll]);

  const renderItemCell = (r,i) => {
    let itemsList = (r.category==='ブランド' || r.category==='バッグ') ? brands : (itemMaster[r.category] || []);
    const detailsList = DETAIL_MAP[r.category] || [];

    if(r.category==='貴金属'){
      return (
        <div style={{display:'grid', gap:6}}>
          {r.manualItem ? (
            <>
              <input value={r.item||''} onChange={e=>{ const v=e.target.value; upd(i,'item', v); upd(i,'name', (v||'') + (r.detail? ' '+r.detail:'')); }} placeholder="品目を手入力（例：K18ネックレス）" style={{padding:6}} />
              <button onClick={()=>upd(i, null, { ...r, manualItem:false })} style={{padding:'4px 8px'}}>プルダウンに戻す</button>
            </>
          ) : (
            <>
              <select value={r.item||''} onChange={e=>{ const lbl=e.target.value; if (lbl===MANUAL_OPTION){ upd(i, null, { ...r, manualItem:true, sync:false, priceKey:'' }); return; } const key=metalKeyFromLabel(lbl); upd(i,'item', lbl); upd(i,'name', lbl + (r.detail? ' '+r.detail:'')); applyFromPrice(i, key); }} style={{padding:6}}>
                <option value={MANUAL_OPTION}>（手入力）</option>
                {METAL_ITEMS.map(m=> <option key={m.k} value={m.label}>{m.label}</option>)}
              </select>
              <select value={r.detail||''} onChange={e=>{ const d=e.target.value; upd(i,'detail', d); upd(i,'name', (r.item||'') + (d? ' '+d:'')); }} style={{padding:6}}>
                <option value="">— 詳細 —</option>
                {detailsList.map(d=> <option key={d} value={d}>{d}</option>)}
              </select>
              <label style={{display:'flex',alignItems:'center',gap:6,fontSize:12,color:'#555'}}>
                <input type="checkbox" checked={!!r.sync} onChange={e=>upd(i,'sync', e.target.checked)} /> 相場と単価を同期
              </label>
            </>
          )}
        </div>
      );
    }

    return (
      <div style={{display:'grid', gap:6}}>
        {r.manualItem ? (
          <>
            <input value={r.item||''} onChange={e=>{ const v=e.target.value; upd(i,'item', v); upd(i,'name', (v||'') + (r.detail? ' '+r.detail:'')); }} placeholder="品目を手入力" style={{padding:6}} />
            <button onClick={()=>upd(i, null, { ...r, manualItem:false })} style={{padding:'4px 8px'}}>プルダウンに戻す</button>
          </>
        ) : (
          <>
            <select value={r.item||''} onChange={e=>{ const v=e.target.value; if (v===MANUAL_OPTION){ upd(i, null, { ...r, manualItem:true }); return; } upd(i,'item', v); upd(i,'name', v + (r.detail? ' '+r.detail:'')); }} style={{padding:6}}>
              <option value={MANUAL_OPTION}>（手入力）</option>
              <option value="">— 品目 —</option>
              {itemsList.map(n=> <option key={n} value={n}>{n}</option>)}
            </select>
            <select value={r.detail||''} onChange={e=>{ const d=e.target.value; upd(i,'detail', d); upd(i,'name', (r.item||'') + (d? ' '+d:'')); }} style={{padding:6}}>
              <option value="">— 詳細 —</option>
              {detailsList.map(d=> <option key={d} value={d}>{d}</option>)}
            </select>
          </>
        )}
      </div>
    );
  };

  return (
    <section style={{border:'1px solid #eee', borderRadius:10, padding:12, display:'grid', gap:8}}>
      <div style={{fontWeight:700, color:BRAND_RED}}>査定計算表（統合）</div>
      <div style={{display:'flex', gap:8, flexWrap:'wrap', alignItems:'center'}}>
        <button onClick={addRow} style={{background:'#111', color:'#fff', padding:'8px 12px', border:'none', borderRadius:8}}>行を追加</button>
        <button onClick={reapplyAll} style={{background:'#fff', color:'#111', padding:'8px 12px', border:'1px solid #111', borderRadius:8}}>相場から再適用</button>
        <span style={{fontSize:12,color:'#666'}}>※「貴金属」行で「相場と単価を同期」がONの行に適用</span>
      </div>
      <div style={{overflowX:'auto'}}>
        <table style={{borderCollapse:'collapse', width:'100%'}}>
          <thead>
            <tr style={{background:'#f9fafb'}}>
              <th style={{border:'1px solid #ddd', padding:6, textAlign:'right'}}>No.</th>
              <th style={{border:'1px solid #ddd', padding:6}}>✓</th>
              <th style={{border:'1px solid #ddd', padding:6}}>カテゴリ</th>
              <th style={{border:'1px solid #ddd', padding:6}}>品目／詳細</th>
              <th style={{border:'1px solid #ddd', padding:6, textAlign:'right'}}>数量</th>
              <th style={{border:'1px solid #ddd', padding:6, textAlign:'right'}}>売却見込(¥/単位)</th>
