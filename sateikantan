/* ========= Snapshots (save/load current sheet & contract) ========= */
function SnapshotsSection(){
  const KEY='snapshotsV1';
  const loadSnaps = ()=>{ try{ const a=JSON.parse(localStorage.getItem(KEY)||'[]'); return Array.isArray(a)? a:[]; }catch{ return []; } };
  const saveSnaps = (a)=>{ try{ localStorage.setItem(KEY, JSON.stringify(a||[])); }catch{} };
  const [list, setList] = React.useState(loadSnaps());
  const [name, setName] = React.useState('');
  const refresh = ()=> setList(loadSnaps());
  const save = ()=>{
    const snap = {
      id: 'S'+Date.now(), name: (name||'無題'), created: new Date().toISOString(),
      company: loadJSON(LS.company, DEFAULT_COMPANY),
      customer: loadJSON(LS.customer, DEFAULT_CUSTOMER),
      payment: loadJSON(LS.payment, {method:'現金'}),
      storeCode: loadJSON(LS.storeCode, {code:'KI'}),
      lead: loadJSON(LS.lead, { channel:'', sub:'', detail:'', couponLetter:'', couponNumber:'' }),
      items: loadArray(LS.items),
    };
    const a = loadSnaps(); a.push(snap); saveSnaps(a); setName(''); refresh(); showToast('スナップショットを保存しました');
  };
  const restore = (s)=>{
    try{
      saveJSON(LS.company, s.company||{});
      saveJSON(LS.customer, s.customer||{});
      saveJSON(LS.payment, s.payment||{});
      saveJSON(LS.storeCode, s.storeCode||{});
      saveJSON(LS.lead, s.lead||{});
      saveArray(LS.items, Array.isArray(s.items)? s.items: []);
      window.dispatchEvent(new Event('RELOAD_ITEMS'));
      showToast('読み込みました。査定計算表とプレビューでご確認ください。');
    }catch{ showToast('読み込みに失敗しました','error'); }
  };
  const remove = (id)=>{ const a=loadSnaps().filter(s=>s.id!==id); saveSnaps(a); refresh(); };
  const preview = (s, internal=false)=>{
    const totals = (function(){ const subtotal=(s.items||[]).reduce((t,it)=> t + (Number(it.payoutManual||0) && it.payoutMode==='manual' ? floor100(Number(it.payoutManual||0)) : floor100(Number(it.unit||0)*Number(it.qty||0)*Number(it.rate||0)/10)), 0); const tax=Math.floor(subtotal*0.10); return { subtotal, tax, total:subtotal+tax }; })();
    const rows = (s.items||[]).filter(r=>r && r.selected).map(r=>({ category:r.category, name:r.name||[r.item,r.detail].filter(Boolean).join(' '), qty:Number(r.qty||0), sale:Number(r.unit||0)*Number(r.qty||0), payout:(r.payoutMode==='manual'? floor100(Number(r.payoutManual||0)) : floor100(Number(r.unit||0)*Number(r.qty||0)*Number(r.rate||0)/10) ) }));
    openPreview({ company: s.company||DEFAULT_COMPANY, customer: s.customer||DEFAULT_CUSTOMER, items: rows, totals, payment: s.payment||{method:'現金'}, storeCode: (s.storeCode&&s.storeCode.code)||'KI', internal, lead: s.lead||{} });
  };
  return (
    <section style={{border:'1px solid #eee', borderRadius:10, padding:12, display:'grid', gap:8}}>
      <div style={{fontWeight:700, color:BRAND_RED}}>案件スナップショット（保存／読み込み）</div>
      <div style={{display:'flex', gap:8, alignItems:'center', flexWrap:'wrap'}}>
        <input value={name} onChange={e=>setName(e.target.value)} placeholder="スナップショット名（例：2025-08-10 午後の案件）" style={{padding:8, minWidth:260}} />
        <button onClick={save} style={{background:BRAND_RED, color:'#fff', padding:'8px 12px', border:'none', borderRadius:8}}>保存</button>
        <span style={{fontSize:12,color:'#666'}}>※ 署名画像は容量節約のため含めません（プレビュー時は現行の署名を使用）。</span>
      </div>
      <div style={{display:'grid', gap:6}}>
        {list.length===0 && <div style={{fontSize:12,color:'#666'}}>保存済みのスナップショットはありません。</div>}
        {list.map(s=> (
          <div key={s.id} style={{display:'flex', gap:8, alignItems:'center', border:'1px solid #eee', borderRadius:8, padding:8, flexWrap:'wrap'}}>
            <div style={{minWidth:220}}><b>{s.name}</b><div style={{fontSize:12,color:'#666'}}>{new Date(s.created).toLocaleString('ja-JP')}</div></div>
            <div style={{display:'flex', gap:8}}>
              <button onClick={()=>preview(s,false)} style={{padding:'6px 10px', border:'1px solid #111', background:'#fff', borderRadius:6}}>お客様控プレビュー</button>
              <button onClick={()=>preview(s,true)} style={{padding:'6px 10px', border:'1px solid #111', background:'#fff', borderRadius:6}}>社内控プレビュー</button>
              <button onClick={()=>restore(s)} style={{background:'#16a34a', color:'#fff', padding:'6px 10px', border:'none', borderRadius:6}}>読み込み（復元）</button>
              <button onClick={()=>remove(s.id)} style={{padding:'6px 10px', border:'1px solid #111', background:'#fff', borderRadius:6}}>削除</button>
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}

/** ========= Preview (Customer/Internal) ========= */
function openPreview({ company, customer, items, totals, payment, storeCode, internal = false, lead }){
  const contractNo = (function(){ try{ const code = storeCode || "KI"; const k = `${code}-seq`; const now = new Date(); const y = now.getFullYear(); const m = String(now.getMonth()+1).padStart(2,'0'); const d = String(now.getDate()).padStart(2,'0'); const today = `${y}${m}${d}`; const raw = JSON.parse(localStorage.getItem(k)||"{}"); const seq = raw.day === today ? (Number(raw.seq||0)+1) : 1; return `保存時に採番（予定: ${code}-${today}-${String(seq).padStart(3,'0')}）`; }catch{ return '保存時に採番'; } })();
  const headerTitle = internal ? "買取契約書（社内控／社外秘）" : "買取契約書（お客様控）";
  const leadStr = lead ? ((lead.channel||'') + (lead.sub ? '／'+lead.sub : '') + (lead.detail ? '／'+lead.detail : '')) : '';
  const couponStr = lead && lead.couponLetter && lead.couponNumber ? `${lead.couponLetter}-${String(lead.couponNumber).padStart(2,'0')}` : '';
  const custSig = getSig(LS.signCustomer) || "";

  const rowsHtml = (items||[]).map((it, idx)=>{
    const qty = Number(it.qty||0);
    const payout = Number(it.payout||0);
    const sale = Number(it.sale||0);
    const profit = sale ? (sale - payout) : 0;
    if(internal){
      return '<tr>'
        + '<td style="text-align:right">'+(idx+1)+'</td>'
        + '<td>'+ (it.category||'') +'</td>'
        + '<td>'+ (it.name||'') +'</td>'
        + '<td style="text-align:right">'+ qty +'</td>'
        + '<td style="text-align:right">¥'+ sale.toLocaleString() +'</td>'
        + '<td style="text-align:right">¥'+ payout.toLocaleString() +'</td>'
        + '<td style="text-align:right">¥'+ profit.toLocaleString() +'</td>'
        + '</tr>';
    }
    return '<tr>'
      + '<td style="text-align:right">'+(idx+1)+'</td>'
      + '<td>'+ (it.category||'') +'</td>'
      + '<td>'+ (it.name||'') +'</td>'
      + '<td style="text-align:right">'+ qty +'</td>'
      + '<td style="text-align:right">¥'+ payout.toLocaleString() +'</td>'
      + '</tr>';
  }).join('');

  const thead = internal
    ? '<tr><th>No.</th><th>カテゴリ</th><th>品目</th><th style="text-align:right">数量</th><th style="text-align:right">上代</th><th style="text-align:right">下代</th><th style="text-align:right">粗利</th></tr>'
    : '<tr><th>No.</th><th>カテゴリ</th><th>品目</th><th style="text-align:right">数量</th><th style="text-align:right">支払（税抜）</th></tr>';

  const totalsHtml = internal ? '' : (
    `<div class="totals">小計（税抜） ¥${(totals?.subtotal||0).toLocaleString()} ／ 消費税(10%) ¥${(totals?.tax||0).toLocaleString()} ／ <b>税込合計 ¥${(totals?.total||0).toLocaleString()}</b></div>`
  );

  const subtotal = (totals && totals.subtotal) || 0; const tax = (totals && totals.tax) || 0; const grand = (totals && totals.total) || 0;
const html = '<!doctype html><html><head><meta charset="utf-8"><title>' + headerTitle + '</title>' +
  '<style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,"Hiragino Kaku Gothic ProN",Meiryo,sans-serif;margin:0;padding:16px;color:#111;position:relative}' +
  'h2{margin:0 0 8px;color:' + BRAND_RED + '}' +
  'table{border-collapse:collapse;width:100%;margin-top:10px}' +
  'th,td{border:1px solid #ddd;padding:6px;font-size:13px} th{background:#f9fafb;text-align:left}' +
  '.totals{margin-top:10px;text-align:right}' +
  '.wm{position:fixed;inset:0;display:' + (internal ? 'block' : 'none') + ';pointer-events:none}' +
  '.wm span{position:absolute;top:35%;left:10%;font-size:120px;color:' + BRAND_RED + ';opacity:.08;transform:rotate(-24deg)}' +
  '.warn{color:' + BRAND_RED + ';font-weight:700}' +
  '@media print{button{display:none}}' +
  '</style></head><body>' +
  '<div class="wm"><span>社内控／社外秘</span></div>' +
  '<h2>' + headerTitle + '</h2>' +
  '<div>契約番号: ' + contractNo + '　契約日: ' + new Date().toLocaleDateString('ja-JP') + '</div>' +
  '<div>' + (company.company||'') + '／' + (company.store||'') + '</div>' +
  '<div>TEL ' + (company.tel1||'') + ' / ' + (company.tel2||'') + '　 許可 ' + (company.permit||'') + '</div>' +
  '<div>' + (company.note||"") + '</div>' +
  (internal ? '<div class="warn">※ この書類は社内控です。お客様へは渡さないでください。</div>' : '') +
  '<h3 style="margin:12px 0 6px">お客様情報</h3>' +
  '<div>氏名：' + (customer.name||'') + '　電話：' + (customer.phone||'') + '</div>' +
  '<div>住所：' + (customer.address||'') + '</div>' +
  '<div>本人確認：' + (customer.idType||'') + '（番号：' + (customer.idNumber||'') + '／有効期限：' + (customer.idExpiry||'') + '）</div>' +
  (internal && leadStr ? '<div>流入：' + leadStr + '</div>' : '') +
  (internal && couponStr ? '<div>クーポン：' + couponStr + '</div>' : '') +
  '<h3 style="margin:12px 0 6px">明細</h3>' +
  '<table><thead>' + thead + '</thead><tbody>' + rowsHtml + '</tbody></table>' +
  (internal ? '' : ('<div class="totals">小計（税抜） ¥' + subtotal.toLocaleString() + ' ／ 消費税(10%) ¥' + tax.toLocaleString() + ' ／ <b>税込合計 ¥' + grand.toLocaleString() + '</b></div>')) +
  '<h3 style="margin:14px 0 6px">署名</h3>' +
  '<div style="display:flex;gap:24px;align-items:flex-start;margin-top:8px">' +
  '<div><div style="font-size:12px;color:#555">お客様署名</div>' +
  (custSig ? '<img src="' + custSig + '" style="width:260px;height:auto;border:1px solid #ddd;border-radius:6px" />' : '<div style="width:260px;height:120px;border:1px dashed #bbb;border-radius:6px"></div>') +
  '</div></div>' +
  '<button onclick="window.print()" style="margin-top:12px;padding:8px 12px;border:1px solid ' + BRAND_RED + ';background:#fff;color:' + BRAND_RED + ';border-radius:8px;cursor:pointer">印刷（PDF保存）</button>' +
  '</body></html>';

  const w = window.open('', '_blank'); if(!w){ showToast('ポップアップを許可してください','warn'); return; }
  w.document.write(html);
  w.document.close();
}

